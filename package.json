{
  "name": "outilflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "setup": "prisma db push && prisma db seed",
    "postinstall": "prisma generate",
    "ml:install": "python -m pip install -r ml/requirements.txt",
    "ml:train": "python ml/ml_reference.py",
    "ml:train:echec": "python ml/ml_reference.py --tache echec_livraison",
    "ml:train:rupture": "python ml/ml_reference.py --tache rupture_stock",
    "ml:train:demande": "python ml/ml_reference.py --tache demande_hebdo",
    "ml:train:ca": "python ml/ml_reference.py --tache ca_journalier",
    "ml:generate": "python ml/generer_dataset.py --seed 42 --catalogue prisma/catalogue.json --out ml/data"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
