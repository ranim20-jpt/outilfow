generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Rôles : PARTICULIER | PROFESSIONNEL | ADMIN | LIVREUR
model User {
  id               Int        @id @default(autoincrement())
  nom              String
  prenom           String
  email            String     @unique
  motDePasse       String
  telephone        String?
  adresse          String?
  role             String     @default("PARTICULIER")
  raisonSociale    String?
  matriculeFiscale String?
  disponible       Boolean    @default(true)
  actif            Boolean    @default(true)
  createdAt        DateTime   @default(now())
  panier           Panier?
  commandes        Commande[]
  livraisons       Livraison[] @relation("LivreurLivraisons")
}

model Categorie {
  id       Int       @id @default(autoincrement())
  nom      String    @unique
  produits Produit[]
}

// Les prix sont exprimés en dinars tunisiens, hors TVA (HTVA)
model Produit {
  id              Int            @id @default(autoincrement())
  codeStq         String
  nom             String
  description     String?
  image           String?
  prixDetail      Float?
  prixGros        Float?
  quantiteMinGros Int            @default(10)
  quantiteStock   Int            @default(0)
  seuilAlerte     Int            @default(5)
  unite           String         @default("pièce")
  actif           Boolean        @default(true)
  categorieId     Int
  categorie       Categorie      @relation(fields: [categorieId], references: [id])
  lignesPanier    LignePanier[]
  lignesCommande  LigneCommande[]
  notifications   Notification[]

  @@index([codeStq])
  @@index([categorieId])
}

model Panier {
  id      Int           @id @default(autoincrement())
  userId  Int           @unique
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lignes  LignePanier[]
}

model LignePanier {
  id        Int     @id @default(autoincrement())
  panierId  Int
  produitId Int
  quantite  Int
  panier    Panier  @relation(fields: [panierId], references: [id], onDelete: Cascade)
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@unique([panierId, produitId])
}

// statut : EN_ATTENTE | EN_PREPARATION | PRETE | TERMINEE | ANNULEE
// typeVente : DETAIL | GROS      modeRecuperation : RETRAIT | LIVRAISON
model Commande {
  id               Int             @id @default(autoincrement())
  userId           Int
  dateCommande     DateTime        @default(now())
  statut           String          @default("EN_ATTENTE")
  typeVente        String
  modeRecuperation String
  total            Float
  user             User            @relation(fields: [userId], references: [id])
  lignes           LigneCommande[]
  livraison        Livraison?
}

model LigneCommande {
  id           Int      @id @default(autoincrement())
  commandeId   Int
  produitId    Int
  quantite     Int
  prixUnitaire Float
  sousTotal    Float
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit      Produit  @relation(fields: [produitId], references: [id])
}

// statut : EN_ATTENTE | EN_PREPARATION | EN_COURS | LIVREE | ECHEC
model Livraison {
  id               Int                   @id @default(autoincrement())
  commandeId       Int                   @unique
  livreurId        Int?
  adresseLivraison String
  gouvernorat      String?
  ville            String?
  // Position GPS exacte choisie par le client sur la carte
  latitude         Float?
  longitude        Float?
  fraisLivraison   Float
  statut           String                @default("EN_ATTENTE")
  dateAffectation  DateTime?
  commande         Commande              @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  livreur          User?                 @relation("LivreurLivraisons", fields: [livreurId], references: [id])
  historique       HistoriqueLivraison[]
}

model HistoriqueLivraison {
  id             Int       @id @default(autoincrement())
  livraisonId    Int
  statut         String
  dateChangement DateTime  @default(now())
  livraison      Livraison @relation(fields: [livraisonId], references: [id], onDelete: Cascade)
}

// type : STOCK_FAIBLE | RUPTURE | PROMO | ANNONCE
// cible : ADMIN (alertes stock, lues côté admin) | CLIENT (promos/annonces visibles par les clients)
model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  titre     String?
  message   String
  date      DateTime @default(now())
  lue       Boolean  @default(false)
  cible     String   @default("ADMIN")
  produitId Int?
  produit   Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull)
}
